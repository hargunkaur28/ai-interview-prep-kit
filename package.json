{
  "name": "ai-interview-prep-kit",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --workspace=shared run build && npm --workspace=server run build && npm --workspace=client run build",
    "test": "npm --workspace=server run test",
    "evaluate": "npm --workspace=server run evaluate --"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
